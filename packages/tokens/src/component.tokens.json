{
  "$description": "Component tokens: the only tokens components.css may read besides semantic ones. They alias semantic tokens so a component can be re-themed without touching the roles.",
  "component": {
    "button": {
      "radius": { "$type": "dimension", "$value": "{radius.full}" },
      "border-width": { "$type": "dimension", "$value": "{border-width.thin}" },
      "font": { "$type": "typography", "$value": "{typography.label}" }
    },
    "field": {
      "radius": { "$type": "dimension", "$value": "{radius.full}" },
      "border-width": { "$type": "dimension", "$value": "{border-width.thin}" }
    },
    "switch": {
      "width": { "$type": "dimension", "$value": "44px" },
      "height": { "$type": "dimension", "$value": "24px" },
      "thumb": { "$type": "dimension", "$value": "18px" }
    },
    "slider": {
      "track-height": { "$type": "dimension", "$value": "4px" },
      "thumb": { "$type": "dimension", "$value": "16px" }
    },
    "progress": {
      "height": { "$type": "dimension", "$value": "4px" }
    },
    "toggle-box": {
      "size": { "$type": "dimension", "$value": "16px" }
    },
    "spinner": {
      "size": { "$type": "dimension", "$value": "16px" },
      "stroke": { "$type": "dimension", "$value": "2px" },
      "period": { "$type": "duration", "$value": "800ms" }
    },
    "badge": {
      "radius": { "$type": "dimension", "$value": "{radius.full}" },
      "font": { "$type": "typography", "$value": "{typography.small}" }
    },
    "panel": {
      "radius": { "$type": "dimension", "$value": "{radius.xl}" }
    },
    "control": {
      "radius": { "$type": "dimension", "$value": "{radius.lg}" }
    },
    "window": {
      "radius": { "$type": "dimension", "$value": "{radius.xxl}" },
      "gap": { "$type": "dimension", "$value": "8px", "$description": "Between islands, and between them and the window's edge." },
      "control-size": { "$type": "dimension", "$value": "28px" },
      "control-icon": { "$type": "dimension", "$value": "{space.xl}" },
      "close": { "$type": "color", "$value": "{palette.red.500}" },
      "close-icon": { "$type": "color", "$value": "{palette.neutral.1000}" },
      "minimize": { "$type": "color", "$value": "{color.status.warning.fg}", "$description": "The minimise glyph under the pointer." },
      "minimize-tint": { "$type": "color", "$value": "{color.status.warning.bg}", "$description": "The minimise button under the pointer: an amber tint." },
      "maximize": { "$type": "color", "$value": "{color.accent.text}", "$description": "The maximise glyph under the pointer." },
      "maximize-tint": { "$type": "color", "$value": "{color.accent.subtle}", "$description": "The maximise button under the pointer: a cyan tint." }
    },
    "splitter": {
      "hit": { "$type": "dimension", "$value": "8px" }
    }
  }
}
